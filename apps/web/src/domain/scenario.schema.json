{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:lumet:scenario:v2",
  "title": "Scenario v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "scenarioId",
    "title",
    "summary",
    "language",
    "languageVersion",
    "topic",
    "executionKind",
    "preconditions",
    "code",
    "visualization",
    "steps",
    "review",
    "verification",
    "level"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "scenarioId": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "title": {
      "$ref": "#/definitions/text"
    },
    "summary": {
      "$ref": "#/definitions/text"
    },
    "language": {
      "$ref": "#/definitions/text"
    },
    "languageVersion": {
      "$ref": "#/definitions/text"
    },
    "topic": {
      "$ref": "#/definitions/text"
    },
    "executionKind": {
      "enum": ["curated_simulation", "recorded_runtime_trace"]
    },
    "preconditions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/text"
      }
    },
    "code": {
      "$ref": "#/definitions/text"
    },
    "visualization": {
      "$ref": "#/definitions/visualization"
    },
    "steps": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#/definitions/traceStep"
      }
    },
    "review": {
      "oneOf": [
        {
          "$ref": "#/definitions/quizReview"
        },
        {
          "$ref": "#/definitions/prReview"
        }
      ]
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "reference", "sources"],
      "properties": {
        "method": {
          "const": "runtime_test"
        },
        "reference": {
          "$ref": "#/definitions/text"
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^https://"
          }
        }
      }
    },
    "aiInterpretation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "text"],
      "properties": {
        "kind": {
          "const": "ai_interpretation"
        },
        "text": {
          "$ref": "#/definitions/text"
        }
      }
    },
    "level": {
      "enum": ["foundation", "practice"]
    }
  },
  "definitions": {
    "text": {
      "type": "string",
      "minLength": 1
    },
    "visualization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "schemaVersion", "fields"],
      "properties": {
        "type": {
          "const": "variables"
        },
        "schemaVersion": {
          "const": 1
        },
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "type"],
            "properties": {
              "name": {
                "$ref": "#/definitions/text"
              },
              "type": {
                "$ref": "#/definitions/text"
              }
            }
          }
        }
      }
    },
    "traceStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "line", "state", "explanation"],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 0
        },
        "line": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "state": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "explanation": {
          "$ref": "#/definitions/text"
        }
      }
    },
    "quizReview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question", "options", "answer", "rationale", "mode"],
      "properties": {
        "question": {
          "$ref": "#/definitions/text"
        },
        "options": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "text"],
            "properties": {
              "id": {
                "$ref": "#/definitions/text"
              },
              "text": {
                "$ref": "#/definitions/text"
              }
            }
          }
        },
        "answer": {
          "$ref": "#/definitions/text"
        },
        "rationale": {
          "$ref": "#/definitions/text"
        },
        "mode": {
          "const": "quiz"
        }
      }
    },
    "prReview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "filePath",
        "context",
        "requirements",
        "beforeCode",
        "hints",
        "finding",
        "fix"
      ],
      "properties": {
        "mode": {
          "const": "pull_request"
        },
        "filePath": {
          "$ref": "#/definitions/text"
        },
        "context": {
          "$ref": "#/definitions/text"
        },
        "requirements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/text"
          }
        },
        "beforeCode": {
          "$ref": "#/definitions/text"
        },
        "hints": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/text"
          }
        },
        "finding": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "lines",
            "category",
            "rationale",
            "condition",
            "impact",
            "test"
          ],
          "properties": {
            "lines": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "integer",
                "minimum": 1
              }
            },
            "category": {
              "enum": [
                "logic",
                "state",
                "async",
                "exception",
                "performance",
                "other"
              ]
            },
            "rationale": {
              "$ref": "#/definitions/text"
            },
            "condition": {
              "$ref": "#/definitions/text"
            },
            "impact": {
              "$ref": "#/definitions/text"
            },
            "test": {
              "$ref": "#/definitions/text"
            }
          }
        },
        "fix": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "explanation"],
          "properties": {
            "code": {
              "$ref": "#/definitions/text"
            },
            "explanation": {
              "$ref": "#/definitions/text"
            }
          }
        }
      }
    }
  }
}
